<UserControl x:Class="PureClean.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PureClean.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="CleanerItemTemplate" DataType="{x:Type vm:CleanerItemViewModel}">
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource CheckBoxModern}" IsChecked="{Binding IsSelected}"
                              IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource ItemDescription}" />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Grid.Column="1" Text="{Binding ResultText}" Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CustomItemTemplate" DataType="{x:Type vm:CleanerItemViewModel}">
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource CheckBoxModern}" IsChecked="{Binding IsSelected}"
                              IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource ItemDescription}" />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Grid.Column="1" Text="{Binding ResultText}" Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Retirer ce dossier de la liste"
                            Command="{Binding DataContext.RemoveCustomFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Nettoyage" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Supprime les fichiers temporaires et les caches de Windows et de vos applications. Vos choix sont mémorisés. Documents, mots de passe et favoris ne sont jamais touchés." />
        </StackPanel>

        <!-- Résumé et actions -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryText}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource ItemDescription}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Analyser" Style="{StaticResource SecondaryButton}" Command="{Binding ScanCommand}" />
                    <Button Content="Nettoyer" Style="{StaticResource PrimaryButton}" Command="{Binding CleanCommand}" />
                </StackPanel>

                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Éléments -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,-16,0" Padding="0,0,16,0">
            <StackPanel>
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Content="Tout cocher" Style="{StaticResource LinkButton}" Command="{Binding SelectAllCommand}" />
                        <Button Content="Tout décocher" Style="{StaticResource LinkButton}" Command="{Binding SelectNoneCommand}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="WINDOWS" Style="{StaticResource SectionTitle}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding WindowsItems}" ItemTemplate="{StaticResource CleanerItemTemplate}" />

                <TextBlock Text="APPLICATIONS ET NAVIGATEURS" Style="{StaticResource SectionTitle}" />
                <ItemsControl ItemsSource="{Binding ApplicationItems}" ItemTemplate="{StaticResource CleanerItemTemplate}" />
                <TextBlock Style="{StaticResource ItemDescription}" Margin="4,4,0,0"
                           Text="Seules les applications installées sur ce PC sont affichées. Fermez-les avant le nettoyage pour un résultat complet." />

                <StackPanel Visibility="{Binding HasPrivacyItems, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="CONFIDENTIALITÉ DES NAVIGATEURS" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,8">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WarningBrush}"
                                   Text="Supprimer les cookies vous déconnecte de tous les sites. Ces éléments ne sont jamais cochés par défaut, et ne sont nettoyés que si le navigateur est fermé." />
                    </Border>
                    <ItemsControl ItemsSource="{Binding PrivacyItems}" ItemTemplate="{StaticResource CleanerItemTemplate}" />
                </StackPanel>

                <TextBlock Text="NETTOYAGE AVANCÉ DE WINDOWS" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,8">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WarningBrush}"
                               Text="Opérations longues utilisant les outils officiels de Windows. Elles libèrent souvent plusieurs Go, mais empêchent de revenir en arrière (ancienne version de Windows, désinstallation de mises à jour)." />
                </Border>
                <ItemsControl ItemsSource="{Binding AdvancedItems}" ItemTemplate="{StaticResource CleanerItemTemplate}" />

                <DockPanel Margin="0,0,0,0">
                    <Button DockPanel.Dock="Right" Content="Ajouter un dossier…" Style="{StaticResource LinkButton}"
                            Command="{Binding AddCustomFolderCommand}" Margin="0" VerticalAlignment="Bottom" />
                    <TextBlock Text="MES DOSSIERS" Style="{StaticResource SectionTitle}" Margin="4,18,0,0" />
                </DockPanel>
                <TextBlock Style="{StaticResource ItemDescription}" Margin="4,2,0,8"
                           Text="Dossiers dont tout le contenu est supprimé à chaque nettoyage (par exemple le cache d'un logiciel). Les dossiers de Windows et vos documents sont protégés." />
                <ItemsControl ItemsSource="{Binding CustomItems}" ItemTemplate="{StaticResource CustomItemTemplate}" Margin="0,0,0,16" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
