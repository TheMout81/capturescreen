<UserControl x:Class="PureClean.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Paramètres" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Préférences de PureClean, enregistrées uniquement sur ce PC." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,-16,0" Padding="0,0,16,0">
            <StackPanel>
                <!-- Apparence -->
                <TextBlock Text="APPARENCE" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Thème" Style="{StaticResource ItemTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton Style="{StaticResource PillRadio}" Content="Selon Windows" GroupName="Theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}" />
                            <RadioButton Style="{StaticResource PillRadio}" Content="Clair" GroupName="Theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}" />
                            <RadioButton Style="{StaticResource PillRadio}" Content="Sombre" GroupName="Theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Données -->
                <TextBlock Text="DONNÉES" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Ouvrir le dossier" Style="{StaticResource SecondaryButton}" Command="{Binding OpenDataFolderCommand}" />
                            <Button Content="Effacer l'historique" Style="{StaticResource DangerButton}" Command="{Binding ClearHistoryCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Paramètres et historique" Style="{StaticResource ItemTitle}" />
                            <TextBlock Text="{Binding DataFolder}" Style="{StaticResource ItemDescription}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- À propos -->
                <TextBlock Text="À PROPOS" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Resources/PureClean.png" Width="48" Height="48" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Style="{StaticResource ItemTitle}">
                                <Run Text="PureClean" />
                                <Run Text="{Binding Version, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource ItemDescription}" MaxWidth="560"
                                       Text="Logiciel libre (licence MIT). Aucune publicité, aucun abonnement, aucune télémétrie. PureClean n'envoie aucune donnée : seule la page « Mises à jour » utilise Internet, via l'outil winget de Microsoft." />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
