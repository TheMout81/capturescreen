<UserControl x:Class="PureClean.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Paramètres" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Préférences de PureClean, enregistrées uniquement sur ce PC." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,-16,0" Padding="0,0,16,0">
            <StackPanel>
                <!-- Apparence -->
                <TextBlock Text="APPARENCE" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Thème" Style="{StaticResource ItemTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton Style="{StaticResource PillRadio}" Content="Selon Windows" GroupName="Theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}" />
                            <RadioButton Style="{StaticResource PillRadio}" Content="Clair" GroupName="Theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}" />
                            <RadioButton Style="{StaticResource PillRadio}" Content="Sombre" GroupName="Theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nettoyage automatique -->
                <TextBlock Text="NETTOYAGE AUTOMATIQUE" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ScheduleEnabled}" />
                            <StackPanel>
                                <TextBlock Text="Nettoyer automatiquement" Style="{StaticResource ItemTitle}" />
                                <TextBlock Style="{StaticResource ItemDescription}" MaxWidth="600" HorizontalAlignment="Left"
                                           Text="Le Planificateur de tâches de Windows lance PureClean sans fenêtre : il nettoie les éléments cochés dans la page Nettoyage (sauf le nettoyage avancé) puis se ferme. Sur un portable, uniquement sur secteur." />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" IsEnabled="{Binding ScheduleEnabled}">
                            <RadioButton Style="{StaticResource PillRadio}" Content="Chaque jour" GroupName="Frequency"
                                         IsChecked="{Binding Frequency, Converter={StaticResource Equals}, ConverterParameter=Daily}" />
                            <RadioButton Style="{StaticResource PillRadio}" Content="Chaque semaine" GroupName="Frequency"
                                         IsChecked="{Binding Frequency, Converter={StaticResource Equals}, ConverterParameter=Weekly}" />
                            <RadioButton Style="{StaticResource PillRadio}" Content="Chaque mois" GroupName="Frequency"
                                         IsChecked="{Binding Frequency, Converter={StaticResource Equals}, ConverterParameter=Monthly}" />
                            <ComboBox ItemsSource="{Binding DayOptions}" SelectedItem="{Binding SelectedDay}" Width="130" Margin="12,0,0,0"
                                      Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="à" Style="{StaticResource ItemDescription}" VerticalAlignment="Center" Margin="12,0,8,0" />
                            <ComboBox ItemsSource="{Binding HourOptions}" SelectedItem="{Binding SelectedHour}" Width="80" MaxDropDownHeight="260" />
                        </StackPanel>

                        <DockPanel Margin="0,14,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Voir le journal" Style="{StaticResource LinkButton}" Command="{Binding OpenLogCommand}" VerticalAlignment="Center" />
                                <Button Content="Lancer maintenant" Style="{StaticResource SecondaryButton}" Command="{Binding RunNowCommand}" />
                                <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Command="{Binding SaveScheduleCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ScheduleStatus}" Style="{StaticResource ItemDescription}" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource ItemDescription}" Margin="0,8,0,0" FontStyle="Italic"
                                   Text="Si vous déplacez PureClean.exe, cliquez à nouveau sur « Enregistrer »." />
                    </StackPanel>
                </Border>

                <!-- Données -->
                <TextBlock Text="DONNÉES" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Ouvrir le dossier" Style="{StaticResource SecondaryButton}" Command="{Binding OpenDataFolderCommand}" />
                            <Button Content="Effacer l'historique" Style="{StaticResource DangerButton}" Command="{Binding ClearHistoryCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Paramètres et historique" Style="{StaticResource ItemTitle}" />
                            <TextBlock Text="{Binding DataFolder}" Style="{StaticResource ItemDescription}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- À propos -->
                <TextBlock Text="À PROPOS" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Resources/PureClean.png" Width="48" Height="48" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Style="{StaticResource ItemTitle}">
                                <Run Text="PureClean" />
                                <Run Text="{Binding Version, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource ItemDescription}" MaxWidth="560"
                                       Text="Logiciel libre (licence MIT). Aucune publicité, aucun abonnement, aucune télémétrie. PureClean n'envoie aucune donnée : seule la page « Logiciels » utilise Internet, via l'outil winget de Microsoft (et GitHub pour RustDesk), et uniquement quand vous le demandez." />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
