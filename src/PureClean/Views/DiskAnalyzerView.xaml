<UserControl x:Class="PureClean.Views.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PureClean.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Analyse de l'espace disque" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Repérez les dossiers et fichiers qui occupent le plus de place. Rien n'est supprimé sans votre accord, et toujours vers la corbeille." />
        </StackPanel>

        <!-- Choix de la cible -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,12">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Choisir un dossier…" Style="{StaticResource SecondaryButton}" Command="{Binding ScanFolderCommand}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriveTarget}">
                                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,6" ToolTip="{Binding Details}"
                                        Command="{Binding DataContext.ScanDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name, StringFormat='Analyser {0}'}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource ItemDescription}" Margin="0,10,0,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <ProgressBar IsIndeterminate="True" Margin="0,10,0,0"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Résultats -->
        <Grid Grid.Row="2" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Arborescence -->
            <Border Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,4,4,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Ouvrir dans l'Explorateur"
                                    Command="{Binding OpenSelectedCommand}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Envoyer ce dossier à la corbeille"
                                    Command="{Binding DeleteSelectedCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedText}" Style="{StaticResource ItemDescription}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0" />
                    </DockPanel>
                    <TreeView ItemsSource="{Binding Roots}" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
                                <DockPanel ToolTip="{Binding Details}" Background="Transparent">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Width="80" TextAlignment="Right"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Width="56" TextAlignment="Right"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <ProgressBar DockPanel.Dock="Right" Width="80" Height="6" Margin="12,0,0,0"
                                                 Value="{Binding Percent, Mode=OneWay}" Maximum="100" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Plus gros fichiers -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PLUS GROS FICHIERS" Style="{StaticResource SectionTitle}" Margin="8,4,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LargestFiles}" VirtualizingPanel.IsVirtualizing="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LargeFileViewModel}">
                                    <Grid Margin="8,4" ToolTip="{Binding File.Path}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource ItemDescription}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding SizeText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                                <Run Text="{Binding DateText, Mode=OneWay, StringFormat=' · {0} · '}" />
                                                <Run Text="{Binding Folder, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Afficher dans l'Explorateur"
                                                Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Envoyer à la corbeille"
                                                Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
