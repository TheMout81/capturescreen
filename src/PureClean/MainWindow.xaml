<Window x:Class="PureClean.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PureClean.ViewModels"
        Title="PureClean" Width="1100" Height="720" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barre latérale -->
        <Grid Background="{StaticResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="24,28,24,28">
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PureClean" FontSize="20" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Text="Sans pub · Sans abonnement · Sans télémétrie" Foreground="{StaticResource SidebarTextBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedItem}"
                     Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NavigationItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       VerticalAlignment="Center" Width="28" />
                            <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Margin="24,0,24,24">
                <Border Background="#3B2A12" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                        Visibility="{Binding ShowAdminWarning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Lancé sans droits administrateur : certains éléments ne pourront pas être nettoyés."
                               Foreground="#F8C77A" FontSize="11" TextWrapping="Wrap" />
                </Border>
                <TextBlock Foreground="{StaticResource SidebarTextBrush}" FontSize="11" TextWrapping="Wrap">
                    <Run Text="100 % hors ligne — aucune donnée envoyée." />
                    <LineBreak />
                    <Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Page courante -->
        <ContentControl Grid.Column="1" Content="{Binding SelectedItem.Page}" Margin="32,28,32,24" Focusable="False" />
    </Grid>
</Window>
